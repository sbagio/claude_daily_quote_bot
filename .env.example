# Copy to .env for local runs. NEVER commit the real .env.
# In GitHub Actions these live as encrypted repository Secrets instead.

# Required to actually send (not needed for --dry-run):
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Optional tuning (defaults shown):
# WEB_SOURCE_PROBABILITY=0.0        # 0 = your curated bank only; raise to mix in web quotes
# NO_REPEAT_DAYS=30                 # don't repeat a curated quote within this many days
# WEB_TIMEOUT_SECONDS=10
# WEB_SOURCE_URL=https://zenquotes.io/api/random   # or https://api.quotable.io/random
# QUOTES_PATH=quotes.json
# STATE_PATH=state/sent_history.json
